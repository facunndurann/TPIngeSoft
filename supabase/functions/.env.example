# Producción: dominio propio y el mismo VITE_EMPLOYEE_EMAIL_DOMAIN en el POS.
EMPLOYEE_EMAIL_DOMAIN=employees.example.com

# Copiar a supabase/functions/.env y completar para habilitar Checkout Pro.
# Origen HTTPS de la app del comensal, sin ruta, query ni fragmento.
# Ejemplo: https://mesa.example.com
MERCADO_PAGO_APP_URL=
# URL pública HTTPS del receptor, sin query ni fragmento.
# Ejemplo: https://PROJECT_REF.supabase.co/functions/v1/mercado-pago-webhook
MERCADO_PAGO_WEBHOOK_URL=

# Access Token y secreto de webhook se cargan desde Restaurante > Mercado Pago.
# El backend los almacena cifrados por restaurante en Supabase Vault.
# Nunca agregar credenciales de Mercado Pago a VITE_*, al frontend o a git.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase.
# Setup, pruebas y despliegue: docs/MERCADO_PAGO.md
