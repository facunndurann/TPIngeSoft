# Only the internal email domain is needed in addition to injected Supabase secrets.
# Production: use a controlled subdomain and the same VITE_EMPLOYEE_EMAIL_DOMAIN in POS.
EMPLOYEE_EMAIL_DOMAIN=employees.example.com
# Simulador controlado de desarrollo. En producción debe quedar deshabilitado.
# Las credenciales reales o de prueba de Mercado Pago no van en este archivo ni
# en variables globales: el panel las guarda cifradas por restaurante en Vault.
PAYMENT_SANDBOX_ENABLED=true
