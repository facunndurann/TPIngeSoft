{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@supabase/supabase-js": ["../../apps/customer/node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["_shared/**/*.ts", "submit-order/handler.ts", "submit-order/gateway.ts", "employee-accounts/handler.ts", "employee-accounts/gateway.ts", "mobile-payment/handler.ts", "mobile-payment/gateway.ts"]
}
