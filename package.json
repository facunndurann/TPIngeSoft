{
  "name": "restaurant-platform",
  "private": true,
  "version": "0.0.1",
  "description": "Plataforma web de autoservicio inteligente para restaurantes (men\u00fa QR, pedidos, POS propio y pagos)",
  "scripts": {
    "dev:customer": "pnpm --filter customer dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:pos": "pnpm --filter pos dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:orders",
    "typecheck:orders": "pnpm --filter customer exec tsc --project ../../supabase/functions/tsconfig.json",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:local": "bash scripts/ci-local.sh",
    "test": "vitest run",
    "test:sql": "bash supabase/tests/run-sql.sh",
    "test:employees:integration": "node supabase/tests/employees.integration.mjs",
    "test:orders:integration": "node --experimental-strip-types supabase/tests/orders.integration.mjs",
    "dev:functions": "supabase functions serve --env-file supabase/functions/.env.example",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:schema": "supabase db dump --local --schema public -f supabase/schema.generated.sql"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "supabase": "^2.45.5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
