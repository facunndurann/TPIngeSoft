#!/usr/bin/env bash

# Salir inmediatamente si algún comando falla
set -e

echo "🚀 Iniciando pruebas locales (CI replica)..."
echo "==========================================="

echo "📦 1. Instalando dependencias (si es necesario)..."
pnpm install

echo -e "\n🧪 2. Ejecutando tests de lógica (Customer)..."
pnpm --filter customer test

echo -e "\n☁️  3. Ejecutando tests de la función (Orders)..."
pnpm test:orders

echo -e "\n🔍 4. Ejecutando verificación de tipos (Typecheck)..."
pnpm typecheck

echo -e "\n🧹 5. Ejecutando linter..."
pnpm lint

echo -e "\n🏗️  6. Construyendo la aplicación (Build)..."
pnpm build

echo -e "\n==========================================="
echo "✅ ¡Todo perfecto! Los tests pasaron exitosamente y no se rompió nada."
